{
  "name": "steward-mock-server",
  "version": "0.0.0",
  "description": "Standalone in-memory mock of the whole Steward gateway API, shared by web, iOS and Android",
  "author": "The Steward Authors",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "steward-mock-server": "bin/steward-mock-server.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#product/*": "./src/product/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steward-GRC/steward-mock-server.git"
  },
  "homepage": "https://github.com/Steward-GRC/steward-mock-server#readme",
  "bugs": {
    "url": "https://github.com/Steward-GRC/steward-mock-server/issues"
  },
  "scripts": {
    "start": "node bin/steward-mock-server.mjs",
    "test": "node --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@bugs5382/node-oxlint-config": "1.0.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "~6.0.0"
  }
}
